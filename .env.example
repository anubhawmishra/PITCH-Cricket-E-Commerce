# PITCH™ Frontend Environment Variables
# Copy to .env.local and fill in values

# Backend API URL (use http://localhost:5000/api for local dev)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay public key (SAFE to put here — this is not the secret)
VITE_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
